{
    admin off
    auto_https disable_redirects
    http_port 8080
    https_port 8443
    # Do not log request objects/URIs on upstream failure. Access logs are disabled.
    log default {
        exclude http.log.error
    }
    servers {
        max_header_size 32KB
        timeouts {
            read_header 5s
            read_body 10s
            write 30s
            idle 60s
        }
    }
}
import /etc/caddy/app.caddy

# 80 -> 8080, 443 -> 8443: no privileged ports or capabilities in the container.
http://{$MINIAPP_DOMAIN}:8080 {
    redir https://{$MINIAPP_DOMAIN}{uri} 308
}
https://{$MINIAPP_DOMAIN}:8443 {
    header Strict-Transport-Security "max-age=31536000"
    import app
}
# Readiness is container-local, not a published port.
http://127.0.0.1:8081 {
    bind 127.0.0.1
    respond /_health ok 200
}
