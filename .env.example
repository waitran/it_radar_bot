# Fill locally with a NEW BotFather token. Never commit the completed .env.
TELEGRAM_BOT_TOKEN=
# Необязательно; при обновлении сохраните прежний ID для переноса владельца.
OWNER_TELEGRAM_ID=0
POLL_INTERVAL_SECONDS=3600
# For local Python only; Docker Compose sets /data/bot.db explicitly.
DB_PATH=./data/bot.db
