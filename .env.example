# Fill locally with a NEW BotFather token. Never commit the completed .env.
TELEGRAM_BOT_TOKEN=
# Необязательно; при обновлении сохраните прежний ID для переноса владельца.
OWNER_TELEGRAM_ID=0
POLL_INTERVAL_SECONDS=3600
# For local Python only; Docker Compose sets /data/bot.db explicitly.
DB_PATH=./data/bot.db

# Общий кооперативный бюджет сбора одного источника.
SOURCE_TIMEOUT_SECONDS=600

# Сетевой timeout запросов к источникам; бюджет источника может уменьшить его.
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"

# Максимальный возраст подтверждения публикации перед отправкой.
ITEM_VERIFICATION_TTL_SECONDS=300

# Копии вне Docker volume базы; храните дополнительную копию вне этого компьютера.
BACKUP_HOST_PATH=./backups
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7

# Возраст самой старой активной доставки для healthcheck.
MAX_QUEUE_AGE_SECONDS=86400

# Ограничения Docker; историю событий автоматически не удаляем.
BOT_MEMORY_LIMIT=512m
BOT_CPU_LIMIT=1.0
BOT_PIDS_LIMIT=128
MIN_FREE_DISK_MB=1024

# UID/GID непривилегированного бота. Можно выбрать UID/GID пользователя хоста.
BOT_UID=10001
BOT_GID=10001

# Optional Mini App launch (leave empty until a real HTTPS URL is available).
MINIAPP_URL=
MINIAPP_MENU_BUTTON=0
