# Only application source, non-secret configuration and tests enter the build.
**
!Dockerfile
!requirements.txt
!config.yaml
!app/
!app/*.py
!app/collectors/
!app/collectors/*.py
!tests/
!tests/*.py
!tests/fixtures/
!tests/fixtures/telegram/
!tests/fixtures/telegram/*.html
!tests/fixtures/websites/
!tests/fixtures/websites/*.html
!tests/fixtures/websites/*.json

!scripts/
!scripts/check_repository.py


# Read-only Mini App API is needed by its integration tests, not the bot runtime.
!miniapp/
!miniapp/__init__.py
!miniapp/backend/
!miniapp/backend/*.py
!miniapp/backend/requirements.txt
